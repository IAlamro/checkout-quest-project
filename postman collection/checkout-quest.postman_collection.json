    {
      "name": "Payment",
      "item": [
        {
          "name": "6. Initiate Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code !== 201) {",
                  "  console.error('Initiate Payment failed:', pm.response.text());",
                  "  return;",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test('paymentId present', () => pm.expect(body.paymentId).to.be.a('string'));",
                  "pm.test('providerRef present', () => pm.expect(body.providerRef).to.be.a('string'));",
                  "pm.collectionVariables.set('paymentId', body.paymentId);",
                  "// providerRef is also captured in step 7 (GET Payment) which is more reliable",
                  "if (body.providerRef) pm.collectionVariables.set('providerRef', body.providerRef);",
                  "console.log('paymentId =',  body.paymentId);",
                  "console.log('providerRef =', body.providerRef);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",    "value": "application/json" },
              { "key": "Idempotency-Key", "value": "pay-idem-{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1399.97,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/payment/start",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "payment", "start"]
            }
          }
        },
        {
          "name": "6b. Initiate Payment — Idempotency Replay (same key)",
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "exec": [
                  "// Override idempotency key to a fixed value to test replay",
                  "pm.request.headers.upsert({ key: 'Idempotency-Key', value: 'pay-idem-replay-fixed-key-123' });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// First call reserves the key; replay returns cached 201 or 409 if in-progress",
                  "pm.test('Status 201 or 409', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",    "value": "application/json" },
              { "key": "Idempotency-Key", "value": "pay-idem-replay-fixed-key-123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1399.97,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/payment/start",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "payment", "start"]
            }
          }
        },
        {
          "name": "7. Get Payment (expect AUTHORIZED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is AUTHORIZED', () => pm.expect(body.status).to.eql('AUTHORIZED'));",
                  "pm.test('providerRef set', () => pm.expect(body.providerRef).to.be.a('string'));",
                  "// Authoritative capture — read model always has providerRef once AUTHORIZED",
                  "pm.collectionVariables.set('paymentId',  body.paymentId);",
                  "pm.collectionVariables.set('providerRef', body.providerRef);",
                  "console.log('providerRef captured =', body.providerRef);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "payments"]
            }
          }
        },
        {
          "name": "7b. Get Payment (expect CONFIRMED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is CONFIRMED', () => pm.expect(body.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "payments"]
            }
          }
        },
        {
          "name": "Retry Payment (after FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code !== 201) {",
                  "  console.error('Retry Payment failed:', pm.response.text());",
                  "  return;",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test('new paymentId', () => pm.expect(body.paymentId).to.be.a('string'));",
                  "pm.collectionVariables.set('paymentId', body.paymentId);",
                  "// Re-run '7. Get Payment' after this to capture the new providerRef from the read model",
                  "if (body.providerRef) pm.collectionVariables.set('providerRef', body.providerRef);",
                  "console.log('retry paymentId =',  body.paymentId);",
                  "console.log('retry providerRef =', body.providerRef);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "retry-idem-{{$randomUUID}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/payments/retry",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "payments", "retry"]
            }
          }
        }
      ]
    },
