            },
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "webhook"]
            }
          }
        },
        {
          "name": "Webhook — Duplicate (idempotent replay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Replaying an already-processed eventId must be a no-op (200, not 500)",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evt-conf-duplicate-fixed-id\",\n  \"providerRef\": \"{{providerRef}}\",\n  \"type\": \"CONFIRMED\",\n  \"reason\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "webhook"]
            }
          }
        }
      ]
    },
